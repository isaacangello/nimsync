{
  "name": "nimsync",
  "version": "0.4.0",
  "description": "Sync NVIDIA NIM and free AIHubMix models with the OpenCode model whitelist",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/isaacangello/nimsync#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaacangello/nimsync.git"
  },
  "bugs": {
    "url": "https://github.com/isaacangello/nimsync/issues"
  },
  "keywords": [
    "opencode",
    "nvidia",
    "aihubmix",
    "bun",
    "ai"
  ],
  "files": [
    "src/",
    "scripts/nimsync-stats.sh",
    "README.md",
    "README.pt-BR.md",
    "CHANGELOG.md",
    "CHANGELOG.pt-BR.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "nimsync": "src/index.ts",
    "nimsync-stats": "scripts/nimsync-stats.sh"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "check": "bun src/index.ts check",
    "doctor": "bun src/index.ts doctor",
    "stats": "bash scripts/nimsync-stats.sh",
    "typecheck": "bunx tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bash -n scripts/nimsync-stats.sh",
    "release": "bun scripts/release.ts"
  },
  "dependencies": {
    "ink": "^6.0.0",
    "jsonc-parser": "^3.3.1",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "react-devtools-core": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
